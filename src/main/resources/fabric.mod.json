{
  "schemaVersion": 1,
  "id": "bephax",
  "version": "0.4.9",
  "name": "Bep Hax",
  "description": "A meteor addon collection for playing 2b2t.",
  "authors": [
    "dekrom",
    "meeerkat",
    "and many more devs."
  ],
  "contact": {
    "repo": "https://github.com/dekrom/Bephax/"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "accessWidener": "bep.accesswidener",
  "entrypoints": {
    "meteor": [
      "bep.hax.Bep"
    ]
  },
  "mixins": [
    "bep.mixins.json",
    "bep-meteor.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "25,225,25"
  },
  "depends": {
    "java": ">=21",
    "minecraft": [
      "1.21.11"
    ],
    "meteor-client": "*",
    "xaeroplus": "*",
    "xaeroworldmap": "*",
    "xaerominimap": "*"
  },
  "suggests": {
    "baritone-meteor": "*",
    "baritone": "*",
    "litematica": "*",
    "malilib": "*"
  }
}
